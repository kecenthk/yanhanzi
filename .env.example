# 数据库（MySQL 8 / MariaDB 10.6+）
DATABASE_URL="mysql://yanhanzi:请替换为数据库密码@127.0.0.1:3306/yanhanzi"

# 管理员账号：ADMIN_PASSWORD_HASH 由 npm run hash-password 生成
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
# 仅本地临时调试可用明文，生产环境请使用哈希并清空此项
ADMIN_PASSWORD=""

# 会话签名密钥，至少 32 位随机字符串：openssl rand -base64 48
SESSION_SECRET=""

# 素材上传目录（相对项目根目录或绝对路径），默认 ./uploads
UPLOAD_DIR=""
UPLOAD_MAX_MB="5"

# 首次访问时的公开站点信息；后台可覆盖
NEXT_PUBLIC_SITE_NAME="艳汉子大定制"
NEXT_PUBLIC_SITE_URL="https://yanhanzi.example.com"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WECHAT=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_ADDRESS=""
NEXT_PUBLIC_CONTACT_HOURS=""
